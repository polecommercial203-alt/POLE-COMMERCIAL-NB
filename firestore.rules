rules_version = '2';

/* =============================================================================
 * firestore.rules — Autorité réelle sur les données
 * -----------------------------------------------------------------------------
 * Le cloisonnement présent dans data.js (scopeIdentity, scopeDeals…) est une
 * défense en profondeur CÔTÉ CLIENT : il empêche un accès par une route ou un
 * filtre, mais n'empêche pas quelqu'un d'ouvrir la console. Ces règles-ci, elles,
 * s'appliquent sur les serveurs de Google et ne peuvent pas être contournées.
 *
 * PORTÉE DE CE QUI EST VÉRIFIABLE ICI
 * L'état étant stocké par tranches (un document = plusieurs modules), la règle
 * peut contrôler QUI écrit dans QUELLE tranche, mais pas « ce commercial n'a
 * modifié que ses propres affaires » : la tranche « affaires » contient toutes
 * les affaires. Pour obtenir cette granularité, il faut passer à un document
 * Firestore par affaire — voir MIGRATION.md, étape 2.
 * ========================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    match /orgs/{org} {

      /* ---- Profils : rôle et identité ---- */
      function profile() {
        return get(/databases/$(database)/documents/orgs/$(org)/users/$(request.auth.uid)).data;
      }
      function member() {
        return request.auth != null
          && exists(/databases/$(database)/documents/orgs/$(org)/users/$(request.auth.uid));
      }
      function role() { return profile().role; }
      function active() { return profile().get('active', true) == true; }

      /* Un utilisateur lit sa propre fiche ; seul l'administrateur gère les autres.
       * Créer un compte se fait donc depuis la console ou un outil d'admin, jamais
       * par auto-inscription. */
      match /users/{uid} {
        allow read:   if member() && (request.auth.uid == uid || role() == 'admin');
        allow write:  if member() && active() && role() == 'admin';

        /* Personnalisation du mot de passe au premier accès : l'utilisateur
         * bascule son propre drapeau `mustChange`, et RIEN d'autre. La clause
         * hasOnly l'empêche de profiter de cette ouverture pour se changer de
         * rôle — c'est tout l'intérêt de la restreindre à un champ nommé. */
        allow update: if member()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange'])
          && request.resource.data.mustChange == false;
      }

      /* ---- Tranches d'état ---- */
      match /state/{shard} {

        /* Lecture : tout membre actif. Le filtrage par périmètre reste assuré
         * par l'application (un commercial ne VOIT que ses affaires à l'écran).
         * Note d'honnêteté : un membre techniquement averti peut lire l'ensemble
         * de la tranche. Si la confidentialité entre commerciaux doit être
         * absolue, la granularité par document est indispensable. */
        allow read: if member() && active();

        /* Paramétrage, droits, équipe : direction et administration uniquement. */
        allow write: if member() && active()
          && shard in ['config', 'equipe']
          && role() in ['admin', 'dg', 'dc']
          && request.resource.data._by == request.auth.uid;

        /* Données opérationnelles : tous les profils qui produisent de l'activité.
         * « rep » (reporting) et « apporteur » sont en lecture seule sur l'état ;
         * l'apporteur dépose via la tranche « activite » uniquement. */
        allow write: if member() && active()
          && shard in ['affaires', 'marches', 'documents', 'analytique', 'divers']
          && role() in ['admin', 'dg', 'dc', 'cdc', 'com']
          && request.resource.data._by == request.auth.uid;

        allow write: if member() && active()
          && shard == 'activite'
          && role() in ['admin', 'dg', 'dc', 'cdc', 'com', 'apporteur']
          && request.resource.data._by == request.auth.uid;
      }

      /* ---- Réunions collaboratives ---- */
      match /meetings/{meetingId} {
        allow read: if member() && active();
        allow create, update, delete: if member() && active()
          && role() in ['admin', 'dg', 'dc', 'cdc']
          && (request.resource == null || request.resource.data._by == request.auth.uid);
      }

      /* ---- Journal d'audit (facultatif, voir MIGRATION.md) ----
       * Ajout seul : on n'efface ni ne réécrit une trace. */
      match /audit/{entry} {
        allow read:   if member() && active() && role() in ['admin', 'dg'];
        allow create: if member() && active()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.orgId == org;
        allow update, delete: if false;
      }
    }

    /* Tout le reste est refusé. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
